# ---------- Server ----------
PORT=3000
NODE_ENV=development

# ---------- Admin access ----------
# These emails become admin automatically once Firebase has verified them (Google sign-in counts as verified).
# Optional: defaults to digital.diptimedical@gmail.com
ADMIN_EMAILS=digital.diptimedical@gmail.com

# ---------- MongoDB Atlas ----------
# Atlas → Database → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dipti_medical?retryWrites=true&w=majority

# ---------- Firebase Web (client) config ----------
# Firebase Console → Project settings → General → Your apps → Web app → SDK config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ---------- Firebase Admin (server) service account ----------
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Open the downloaded .json file, copy EVERYTHING, and paste it between the single quotes below.
# Multi-line paste is fine — just keep the opening ' and closing ' quotes.
FIREBASE_SERVICE_ACCOUNT='{
  "type": "service_account",
  "project_id": "your-project",
  "private_key_id": "xxxxx",
  "private_key": "-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com",
  "client_id": "xxxxx",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}'

# ---------- Razorpay (online payments) ----------
# Dashboard → Account & Settings → API Keys. Use test keys (rzp_test_...) until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Dashboard → Webhooks → URL https://<your-site>/api/shop/payments/webhook
# events: payment.captured, order.paid. Paste the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Shop settings (optional, defaults shown) ----------
# SHOP_PHONE=8001506000
# SHOP_EMAIL=digital.diptimedical@gmail.com
# MIN_ORDER_VALUE=200
# CONSULT_TOKEN_AMOUNT=100
